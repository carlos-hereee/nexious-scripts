{
  "name": "nexious-scripts",
  "version": "1.0.0",
  "description": "Codegen, filesystem, and random-string scripts for the nexious ecosystem.",
  "main": "dist/main.js",
  "type": "module",
  "bin": {
    "nexious-random": "dist/bin/random.js",
    "nexious-context": "dist/codegen/generateContext.js"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "clean": "rimraf dist/ && npx prettier --write src/",
    "compile": "npm run compile:tsc && npm run compile:tsc-alias",
    "compile:tsc": "tsc -p tsconfig.json",
    "compile:tsc-alias": "tsc-alias -p tsconfig.json",
    "watch:ts": "tsc -p tsconfig.json --watch",
    "watch:alias": "tsc-alias -p tsconfig.json --watch",
    "watch:lint": "eslint \"src/**/*.{js,ts}\"",
    "pretty": "npx prettier --write src/",
    "generateContext": "node dist/codegen/generateContext.js",
    "random": "node dist/bin/random.js",
    "dedupe:roadmaps": "node scripts/dedupe-roadmaps.mjs",
    "refresh:graphs": "node scripts/refresh-graphs.mjs",
    "roll:sacred": "node scripts/roll-sacred.mjs",
    "extract:assets": "node scripts/asset-extractor/asset-extractor.mjs",
    "test": "node --import tsx --test src/**/*.test.ts",
    "release:patch": "npm run build && npm version patch && npm publish",
    "release:minor": "npm run build && npm version minor && npm publish",
    "release:major": "npm run build && npm version major && npm publish",
    "heal:calendar-app-uid": "node scripts/heal-calendar-app-uid.mjs",
    "normalize:asvab": "node --import tsx scripts/normalize-asvab-csv.mjs"
  },
  "files": [
    "dist",
    "src/random/ports"
  ],
  "keywords": [
    "codegen",
    "scripts",
    "random",
    "uuid",
    "unique-id",
    "nexious"
  ],
  "author": "qwerty <97hernandez.c@gmail.com> (https://www.companyuno.com)",
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.13.4",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-prettier": "^5.2.1",
    "i": "^0.3.7",
    "npm": "^11.19.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
